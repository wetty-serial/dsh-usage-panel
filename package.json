{
  "name": "dsh-usage-panel",
  "version": "0.1.6",
  "description": "Global panel that shows provider usage (OpenCode Go / Claude / free-pool) and the times each meter recovers, read from the usage dashboard API",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dshSetup": { "roles": ["daily-pc", "server"] },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.5 <0.3.0" },
  "author": "wetty_serial",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wetty-serial/dsh-usage-panel.git"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "usage"]
}
